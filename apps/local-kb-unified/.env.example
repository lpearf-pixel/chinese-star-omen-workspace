OPENWEBUI_PORT=3000
OLLAMA_PORT=11434
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
POSTGRES_PORT=5432

POSTGRES_USER=kb_admin
POSTGRES_PASSWORD=replace_me_with_a_strong_password
POSTGRES_DB=knowledge_base

WEBUI_SECRET_KEY=replace_me_with_a_long_random_secret

# Host Ollama is recommended on macOS/Apple Silicon so Metal remains available.
CHAT_MODEL=qwen2.5-coder:7b-instruct
EMBED_MODEL=nomic-embed-text
OLLAMA_EXTRA_MODELS="llama3.2:3b"

KB_SEARCH_API_PORT=8008
KB_SEARCH_API_KEY=replace_me_with_a_long_random_api_key
# Trial release collection. Existing local_kb_default is never recreated by default.
KB_SEARCH_DEFAULT_COLLECTION=local_kb_kaiyuan_v2
KB_QUERY_STELLAR_NORMALIZE=1
KB_OPENCC_CONFIG=s2t
KB_QUERY_DUAL_SCRIPT=0
KB_LITERAL_POOL_FACTOR=12
KB_LITERAL_POOL_CAP=120

# Host-side ingest and local scripts. The container receives host.docker.internal/qdrant via Compose.
OLLAMA_HOST=127.0.0.1
QDRANT_HOST=127.0.0.1

# Official source roots. Relative paths are resolved from apps/local-kb-unified.
KB_SOURCES_ROOT=./data/sources
KB_GENERATED_ROOT=./data/generated

# Optional Obsidian source. Keep disabled until KB_OBSIDIAN_ROOT is configured locally.
KB_ENABLE_OBSIDIAN_SOURCE=false
# KB_OBSIDIAN_ROOT="/path/to/your/_kb-ingest"
KB_OBSIDIAN_INGEST_SOURCE_LABEL=obsidian
KB_OBSIDIAN_SOURCE_ROOT_LABEL=_kb-ingest
KB_KAIYUAN_METADATA_INFER=1

# Optional pip mirror used only while building the kb-search image.
# PIP_INDEX_URL=https://pypi.example/simple
# PIP_TRUSTED_HOST=pypi.example
