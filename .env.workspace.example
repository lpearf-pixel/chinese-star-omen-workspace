# Workspace
LOCAL_KB_DIR=apps/local-kb-unified
STAR_OMEN_DIR=apps/star-omen

# Upstream KB Search API
KB_SEARCH_BASE_URL=http://127.0.0.1:8008
KB_SEARCH_API_PORT=8008
KB_SEARCH_API_KEY=replace_me_with_a_long_random_api_key
KB_SEARCH_DEFAULT_COLLECTION=local_kb_kaiyuan_v2

# Upstream knowledge sources
KB_SOURCES_ROOT=./data/sources
KB_ENABLE_OBSIDIAN_SOURCE=false
# KB_OBSIDIAN_ROOT="/path/to/your/_kb-ingest"

# Downstream candidate overlay
KB_ENABLE_CANDIDATE_OVERLAY=false
KB_CANDIDATE_OVERLAY_ROOT=./data/generated_candidates
